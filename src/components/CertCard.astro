---
export interface Props {
  title: string;
  issuer: string;
  issued: string;
  href: string;
  iconSrc?: string;
}

const {
  title,
  issuer,
  issued,
  href,
  iconSrc = `${import.meta.env.BASE_URL}images/certs/anthropicresearch_logo.jpg`,
} = Astro.props;

const label = `${title} certificate from ${issuer}, issued ${issued} (opens in new window)`;
---

<a
  href={href}
  class="cert-card"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
>
  <img
    src={iconSrc}
    alt=""
    class="cert-card__icon"
    width="32"
    height="32"
    loading="lazy"
  />
  <div class="cert-card__body">
    <p class="cert-card__title">{title}</p>
    <p class="cert-card__meta">{issuer} · {issued}</p>
  </div>
</a>

<style>
  .cert-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.35rem 0;
    text-decoration: none;
    color: inherit;
    border-radius: 0.25rem;
    transition: color 0.2s ease;
  }

  .cert-card:hover .cert-card__title,
  .cert-card:focus-visible .cert-card__title {
    color: var(--ink);
  }

  .cert-card__icon {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 0.25rem;
    object-fit: contain;
    opacity: 0.85;
  }

  .cert-card__body {
    min-width: 0;
  }

  .cert-card__title {
    font-size: 0.85rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--ink-muted);
    margin: 0 0 0.1rem;
    transition: color 0.2s ease;
  }

  .cert-card__meta {
    font-size: 0.75rem;
    line-height: 1.4;
    color: rgba(74, 85, 104, 0.75);
    margin: 0;
  }
</style>
