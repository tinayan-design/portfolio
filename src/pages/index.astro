---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => {
  if (a.data.order && b.data.order) {
    return a.data.order - b.data.order;
  }
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const base = import.meta.env.BASE_URL;
const projectCount = sortedProjects.length;
---

<Layout title="Tina Yan - UI/UX Designer" description="UI/UX Designer creating innovative digital experiences. View my portfolio of mobile apps, websites, and design systems.">
  <Header theme="editorial" />

  <main id="main-content" class="editorial home">
    <!-- Hero: editorial asymmetric layout, atmospheric background -->
    <section class="hero relative min-h-[100svh] flex items-end lg:items-center overflow-hidden">
      <div class="hero-bg" aria-hidden="true">
        <img
          src={`${base}images/hero-bg.png`}
          alt=""
          class="hero-bg__img"
        />
        <div class="hero-bg__wash"></div>
        <div class="hero-bg__grain"></div>
      </div>

      <div class="hero-inner relative z-10 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-16 lg:pt-32 lg:pb-24">
        <div class="hero-grid lg:grid lg:grid-cols-12 lg:gap-x-10 lg:items-end">
          <div class="lg:col-span-7 xl:col-span-8 hero-copy">
            <p class="hero-eyebrow reveal" style="--i: 0">
              <span class="hero-eyebrow__line" aria-hidden="true"></span>
              UI/UX Designer · Toronto
            </p>
            <h1 class="hero-title reveal" style="--i: 1">
              Designing with <em class="hero-title__name">empathy</em>. Thinking like a <em class="hero-title__name">stakeholder</em>.
            </h1>
            <p class="hero-lead reveal" style="--i: 2">
              I bring a rare combination to UX — years of enterprise experience at TD, and a deep commitment to human-centered design.
            </p>
            <div class="hero-actions reveal" style="--i: 3">
              <a href="#projects" class="btn btn--primary">
                View projects
                <span class="btn__arrow" aria-hidden="true">→</span>
              </a>
              <a
                href="https://www.linkedin.com/in/tinayan-ysl/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--ghost"
                aria-label="LinkedIn (opens in new window)"
              >
                LinkedIn
              </a>
            </div>
          </div>

          <aside class="lg:col-span-5 xl:col-span-4 hero-aside reveal" style="--i: 4" aria-label="Portfolio highlights">
            <ul class="hero-stats">
              <li>
                <span class="hero-stats__value">{projectCount}</span>
                <span class="hero-stats__label">Case studies</span>
              </li>
              <li>
                <span class="hero-stats__value">UX</span>
                <span class="hero-stats__label">Research · UI · Prototyping</span>
              </li>
            </ul>
          </aside>
        </div>
      </div>

      <a href="#projects" class="hero-scroll reveal" style="--i: 5" aria-label="Scroll to projects">
        <span class="hero-scroll__text">Scroll</span>
        <span class="hero-scroll__line" aria-hidden="true"></span>
      </a>
    </section>

    <!-- Projects -->
    <section id="projects" class="work-section">
      <div class="work-section__inner max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <header class="work-header reveal" style="--i: 0">
          <p class="work-header__eyebrow">Selected work</p>
          <div class="work-header__row">
            <h2 class="work-header__title">Projects</h2>
            <span class="work-header__count" aria-hidden="true">{String(projectCount).padStart(2, '0')}</span>
          </div>
          <p class="work-header__desc">
            Mobile apps, marketing sites, and design systems—each shaped around real users and business goals.
          </p>
        </header>

        <div class="work-list">
          {sortedProjects.map((project, i) => (
            <div class="work-item reveal" style={`--i: ${Math.min(i + 1, 6)}`}>
              <span class="work-item__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                image={project.data.image}
                tags={project.data.tags}
                projectUrl={project.data.projectUrl}
                slug={project.slug}
                templateStyle={true}
                imageOnLeft={i % 2 === 1}
              />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="contact-section">
      <div class="contact-section__inner max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 reveal" style="--i: 0">
        <p class="contact-section__eyebrow">Collaborate</p>
        <h2 class="contact-section__title">Let's work together</h2>
        <p class="contact-section__desc">
          I'm open to full-time UX roles and design collaborations in Toronto and beyond. Let's make something worth using.
        </p>
        <a href="mailto:yanlamji@gmail.com" class="btn btn--dark">
          yanlamji@gmail.com
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="site-footer__inner max-w-5xl mx-auto px-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <p class="site-footer__copy">© Tina Yan 2026</p>
        <div class="site-footer__links">
          <a href="https://www.linkedin.com/in/tinayan-ysl/" target="_blank" rel="noopener noreferrer" class="site-footer__link" aria-label="LinkedIn (opens in new window)">
            LinkedIn
          </a>
          <a href="mailto:yanlamji@gmail.com" class="site-footer__link" aria-label="Email Tina">
            Email
          </a>
        </div>
      </div>
    </footer>
  </main>
</Layout>

<style>
  /* —— Home hero —— */
  .hero {
    background: var(--cream);
    /* Full viewport width (covers scrollbar-gutter strip on the right) */
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-bg__img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    object-fit: cover;
    object-position: 55% 40%;
    transform: translate(-50%, -50%) scale(1.06);
    filter: saturate(0.85) contrast(1.02);
  }

  .hero-bg__wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(165deg, rgba(246, 243, 238, 0.92) 0%, rgba(246, 243, 238, 0.55) 42%, rgba(246, 243, 238, 0.75) 100%),
      linear-gradient(90deg, rgba(246, 243, 238, 0.94) 0%, rgba(246, 243, 238, 0.55) 48%, rgba(246, 243, 238, 0.28) 78%, rgba(107, 166, 198, 0.15) 100%);
  }

  .hero-bg__grain {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    mix-blend-mode: multiply;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .hero-eyebrow__line {
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--accent-soft);
  }

  .hero-title {
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 2.75rem;
  }

  .hero-title__name {
    font-style: italic;
    color: var(--accent);
    font-weight: 400;
  }

  .hero-lead {
    max-width: 28rem;
    font-size: clamp(0.875rem, 1.25vw, 1rem);
    line-height: 1.65;
    color: var(--ink-muted);
    margin-bottom: 3.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .hero-aside {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(20, 24, 32, 0.1);
  }

  @media (min-width: 1024px) {
    .hero-aside {
      margin-top: 0;
      padding-top: 0;
      border-top: none;
      padding-bottom: 0.5rem;
    }
  }

  .hero-stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .hero-stats {
      align-items: flex-end;
      text-align: right;
    }
  }

  .hero-stats__value {
    display: block;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 2rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.1;
  }

  .hero-stats__label {
    display: block;
    font-size: 0.8rem;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
    margin-top: 0.2rem;
  }

  .hero-scroll {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-muted);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .hero-scroll:hover,
  .hero-scroll:focus-visible {
    color: var(--accent);
  }

  .hero-scroll__line {
    display: block;
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(to bottom, var(--accent-soft), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { opacity: 0.4; transform: scaleY(0.85); }
    50% { opacity: 1; transform: scaleY(1); }
  }

  /* —— Projects —— */
  .work-section {
    padding: 5rem 0 7rem;
    background: #fff;
    position: relative;
  }

  .work-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cream-deep), transparent);
  }

  .work-header {
    margin-bottom: 3.5rem;
  }

  .work-header__eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .work-header__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .work-header__title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    line-height: 1.1;
    color: var(--ink);
  }

  .work-header__count {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 300;
    line-height: 1;
    color: rgba(107, 166, 198, 0.35);
    user-select: none;
  }

  .work-header__desc {
    max-width: 32rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--ink-muted);
  }

  .work-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .work-list {
      gap: 5rem;
    }
  }

  .work-item {
    position: relative;
  }

  .work-item__index {
    position: absolute;
    top: -0.25rem;
    left: -0.25rem;
    z-index: 2;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
    background: #fff;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.06);
  }

  @media (min-width: 768px) {
    .work-item__index {
      left: -2.5rem;
      top: 1.5rem;
      background: transparent;
      box-shadow: none;
      font-size: 1rem;
    }
  }

  .editorial.home .work-item :global(article) {
    border-radius: 1rem;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.8) inset,
      0 12px 40px rgba(20, 24, 32, 0.08);
    border: 1px solid rgba(20, 24, 32, 0.06);
  }

  .editorial.home .work-item :global(article a) {
    border-radius: 999px;
    border-color: var(--ink);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }

  .editorial.home .work-item :global(article a:hover),
  .editorial.home .work-item :global(article a:focus-visible) {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll__line {
      animation: none;
    }
  }
</style>
