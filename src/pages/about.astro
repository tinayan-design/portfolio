---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="About - Tina Yan" description="About Tina Yan, UI/UX Designer. User research, UI design, and prototyping for user-centered digital experiences.">
  <Header currentPage="about" theme="editorial" />

  <main id="main-content" class="editorial about">
    <!-- Hero -->
    <section class="about-hero">
      <div class="editorial-grain" aria-hidden="true"></div>
      <div class="about-hero__inner max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-28 pb-16 lg:pt-32 lg:pb-20">
        <div class="about-hero__grid md:grid md:grid-cols-2 md:gap-16 items-center">
          <div class="about-hero__copy">
            <p class="editorial-eyebrow reveal" style="--i: 0">
              <span class="editorial-eyebrow__line" aria-hidden="true"></span>
              About · Toronto
            </p>
            <h1 class="about-hero__title reveal" style="--i: 1">
              About <em class="about-hero__emphasis">me</em>
            </h1>
            <div class="about-hero__body reveal" style="--i: 2">
              <p class="about-hero__lead">
                I'm a passionate UI/UX designer transitioning into creating user-centered digital experiences.
              </p>
              <p class="about-hero__text">
                My process begins with empathy—understanding the people behind the pixels before sketching a single wireframe. I believe great design should be both beautiful and functional, solving real problems while delighting users.
              </p>
            </div>
            <div class="reveal" style="--i: 3">
              <a
                href={`${base}Resume_Tina-Yan.pdf`}
                download="Resume_Tina Yan.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--primary"
                aria-label="Download Resume (opens in new window)"
              >
                Download resume
                <span class="btn__arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
          <div class="about-hero__portrait reveal" style="--i: 2">
            <div class="about-hero__frame">
              <img
                src={`${base}images/about-hero.png`}
                alt="Tina Yan"
                class="about-hero__img"
                width="600"
                height="600"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tabs: My Story / My Craft -->
    <section class="about-content" id="story">
      <div class="about-content__inner max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <header class="about-content__header reveal" style="--i: 0">
          <p class="editorial-eyebrow">Background</p>
          <h2 class="about-content__title">My story & craft</h2>
        </header>

        <div class="about-tabs" role="tablist" aria-label="About sections">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="panel-story"
            id="tab-story"
            data-tab-button="story"
            class="about-tab is-active"
          >
            My Story
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-craft"
            id="tab-craft"
            data-tab-button="craft"
            class="about-tab"
          >
            My Craft
          </button>
        </div>

        <!-- Panel: My Story -->
        <div id="panel-story" role="tabpanel" aria-labelledby="tab-story" data-tab-panel="story" class="about-panel">
          <div class="timeline">
            <div class="timeline__line" aria-hidden="true"></div>

            <div class="timeline-step timeline-step--reverse">
              <span class="timeline-step__num" aria-hidden="true">01</span>
              <article class="timeline-card timeline-card--quote">
                <p>"I believe that the best solutions are often the simplest ones."</p>
              </article>
            </div>

            <div class="timeline-step">
              <span class="timeline-step__num" aria-hidden="true">02</span>
              <article class="timeline-card">
                <h3 class="timeline-card__title">The pivot</h3>
                <p>As a <strong>UI/UX Designer</strong> and career switcher, I am driven by a philosophy of <strong>"Simple is Best"</strong> — the art of stripping away complexity to reveal intuitive, inclusive, and visually compelling experiences. After several years in the corporate world, most recently as a <strong>Workplace Ambassador at TD</strong>, I decided to follow my passion for creative problem-solving and pivot into the world of UX Design.</p>
              </article>
            </div>

            <div class="timeline-step timeline-step--reverse">
              <span class="timeline-step__num" aria-hidden="true">03</span>
              <article class="timeline-card">
                <h3 class="timeline-card__title">The journey</h3>
                <p>My journey began with the <strong>Google UX Design Professional Certificate</strong>, a rigorous program that allowed me to formalize my design thinking. However, my "design eye" was truly sharpened during my time in corporate environments.</p>
                <p>I spent years managing high-stakes stakeholder needs and navigating complex enterprise workflows. This experience taught me a vital lesson that I carry into every Figma file: <strong>design isn't just about how it looks; it's about how it works for the human on the other side of the screen.</strong></p>
              </article>
            </div>

            <div class="timeline-step">
              <span class="timeline-step__num" aria-hidden="true">04</span>
              <article class="timeline-card">
                <h3 class="timeline-card__title">What I bring to the table</h3>
                <ul class="timeline-card__list">
                  <li><strong>A Human-Centered Approach:</strong> I bridge the gap between business objectives and user empathy.</li>
                  <li><strong>Visual Clarity:</strong> I specialize in creating clean, modern interfaces that prioritize usability without sacrificing aesthetics.</li>
                  <li><strong>Enterprise Literacy:</strong> My background at a major financial institution means I am comfortable with complexity, scale, and cross-functional collaboration.</li>
                  <li><strong>A Growth Mindset:</strong> I am a lifelong learner who embraces the challenge of a new path with curiosity and resilience.</li>
                </ul>
              </article>
            </div>

            <div class="timeline-step timeline-step--reverse">
              <span class="timeline-step__num" aria-hidden="true">05</span>
              <article class="timeline-card">
                <h3 class="timeline-card__title">What's next</h3>
                <p>I am currently seeking a <strong>Junior UX Designer</strong> role where I can contribute to meaningful digital solutions and continue to grow alongside a forward-thinking team.</p>
              </article>
            </div>

            <div class="timeline-step">
              <span class="timeline-step__num" aria-hidden="true">06</span>
              <article class="timeline-card">
                <h3 class="timeline-card__title">Key skills</h3>
                <p class="timeline-card__intro">UX/UI Design, Wireframing, Prototyping, User Research, Figma, Design Systems, and Accessibility (WCAG).</p>
                <div class="timeline-card__tags">
                  <span>UX/UI Design</span>
                  <span>Wireframing</span>
                  <span>Prototyping</span>
                  <span>User Research</span>
                  <span>Figma</span>
                  <span>Design Systems</span>
                  <span>Accessibility (WCAG)</span>
                </div>
              </article>
            </div>

            <div class="timeline-step timeline-step--reverse">
              <span class="timeline-step__num" aria-hidden="true">07</span>
              <article class="timeline-card">
                <h3 class="timeline-card__title">Ready for the next chapter</h3>
                <p>I'm ready to enter the UX design field and open for <strong>full-time working opportunities</strong>. Let's create something meaningful together.</p>
              </article>
            </div>
          </div>
        </div>

        <!-- Panel: My Craft -->
        <div id="panel-craft" role="tabpanel" aria-labelledby="tab-craft" data-tab-panel="craft" class="about-panel about-panel--craft hidden" aria-hidden="true">
          <div class="craft-intro">
            <p class="craft-intro__quote">
              Beyond pixels and prototypes, my design philosophy is rooted in the tactile world.
            </p>
            <p class="craft-intro__text">
              These creative studies explore the core principles—balance, color theory, and visual rhythm. It's where my passion for art meets the precision of user-centered design.
            </p>
          </div>

          <div class="craft-gallery">
            <figure class="craft-item">
              <img src={`${base}images/craft/coasters.jpg`} alt="Hand-painted ceramic coasters: landscapes, florals, and abstracts" width="4032" height="3024" loading="lazy" />
              <figcaption>A study in composition and texture beyond the screen. These hand-painted ceramic coasters explore color theory and tactile elements through varied themes like landscapes, florals, and abstracts.</figcaption>
            </figure>

            <figure class="craft-item">
              <img src={`${base}images/craft/diptych.png`} alt="Diptych: circular form split across two canvases with gold metallic accents and blue gradients" width="4032" height="3024" loading="lazy" />
              <figcaption>
                <em>Painted from inspiration by another artist; source/author unknown.</em>
                A diptych exploring visual balance through high contrast and color gradients. By splitting a singular circular form across two canvases, I experiment with how focal points and metallic accents can unite disparate elements to create a cohesive, harmonious whole.
              </figcaption>
            </figure>

            <figure class="craft-item">
              <img src={`${base}images/craft/forest.png`} alt="Stylized forest painting with metallic accents and cool blue palette, exploring depth and linear perspective" width="4032" height="3024" loading="lazy" />
              <figcaption>An exploration of depth and linear perspective through a stylized forest. By using varying scales and a central focal point, I created a sense of immersion. The metallic accents against the cool blue palette highlight my focus on creating visual interest through contrast.</figcaption>
            </figure>

            <figure class="craft-item">
              <img src={`${base}images/craft/color-block-plant.png`} alt="Bold color blocking with minimalist plant illustration in yellow, teal, orange-red and black" width="4032" height="3024" loading="lazy" />
              <figcaption>
                <em>Painted from inspiration by another artist; source/author unknown.</em>
                Bold color blocking meets minimalist illustration. This canvas highlights my focus on composition and spatial relationships, using a vibrant palette to create harmony between disparate shapes—a core principle I bring to every digital interface I design.
              </figcaption>
            </figure>

            <figure class="craft-item">
              <img src={`${base}images/craft/photo-frame.png`} alt="Hand-painted photo frame with whimsical sky and daisy motif across outer and inner layers" width="4032" height="3024" loading="lazy" />
              <figcaption>Exploring continuity by extending a whimsical sky and daisy motif across the layers of a photo frame. This piece demonstrates my eye for thematic consistency and my passion for transforming functional objects into engaging, delightful visual experiences that tell a story.</figcaption>
            </figure>

            <h3 class="craft-section-title">Studies & Interpretations</h3>

            <figure class="craft-item">
              <img src={`${base}images/craft/starry-night.png`} alt="Tribute to Van Gogh's The Starry Night with swirling sky and expressive brushwork" width="4032" height="3024" loading="lazy" />
              <figcaption>A tribute to Van Gogh's The Starry Night, exploring movement and rhythm through expressive brushwork. This piece demonstrates my eye for visual energy and flow, highlighting how swirling forms and high-contrast accents can guide a viewer's attention across a composition.</figcaption>
            </figure>

            <figure class="craft-item">
              <img src={`${base}images/craft/water-lilies.png`} alt="Monet-inspired impressionist study of water lilies, willow branches, and serene light" width="4032" height="3024" loading="lazy" />
              <figcaption>An impressionist study of tranquility and light. Inspired by Monet, this painting explores organic forms and a serene palette, showcasing my eye for atmospheric harmony and my dedication to learning from classical masters to inform my modern design work.</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <script>
      const tabButtons = document.querySelectorAll('[data-tab-button]');
      const tabList = document.querySelector('[role="tablist"]');

      function activateTab(btn) {
        if (!btn) return;
        const tab = btn.getAttribute('data-tab-button');
        tabButtons.forEach((b) => {
          const selected = b === btn;
          b.setAttribute('aria-selected', selected ? 'true' : 'false');
          b.classList.toggle('is-active', selected);
        });
        document.querySelectorAll('[data-tab-panel]').forEach((panel) => {
          const show = panel.getAttribute('data-tab-panel') === tab;
          panel.classList.toggle('hidden', !show);
          panel.setAttribute('aria-hidden', show ? 'false' : 'true');
        });
      }

      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => activateTab(btn));
      });

      tabList?.addEventListener('keydown', (e) => {
        const tabs = Array.from(tabButtons);
        const currentIndex = tabs.indexOf(document.activeElement);
        if (currentIndex === -1) return;
        let nextIndex = currentIndex;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          nextIndex = (currentIndex + 1) % tabs.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        } else if (e.key === 'Home') {
          e.preventDefault();
          nextIndex = 0;
        } else if (e.key === 'End') {
          e.preventDefault();
          nextIndex = tabs.length - 1;
        }
        if (nextIndex !== currentIndex) {
          const next = tabs[nextIndex];
          if (next) {
            next.focus();
            activateTab(next);
          }
        }
      });
    </script>

    <!-- Contact -->
    <section id="contact" class="contact-section">
      <div class="contact-section__inner max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 reveal" style="--i: 0">
        <p class="contact-section__eyebrow">Collaborate</p>
        <h2 class="contact-section__title">Let's work together</h2>
        <p class="contact-section__desc">
          I'm always interested in new opportunities, freelance projects, and design collaborations.
        </p>
        <a href="mailto:yanlamji@gmail.com" class="btn btn--dark">
          yanlamji@gmail.com
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="site-footer__inner max-w-5xl mx-auto px-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <p class="site-footer__copy">© Tina Yan 2026</p>
        <div class="site-footer__links">
          <a href="https://www.linkedin.com/in/tina-yan-2a3952170/" target="_blank" rel="noopener noreferrer" class="site-footer__link" aria-label="LinkedIn (opens in new window)">LinkedIn</a>
          <a href="mailto:yanlamji@gmail.com" class="site-footer__link" aria-label="Email Tina">Email</a>
        </div>
      </div>
    </footer>
  </main>
</Layout>

<style>
  /* —— About hero —— */
  .about-hero {
    position: relative;
    min-height: min(90svh, 900px);
    display: flex;
    align-items: center;
    background: var(--cream);
    overflow: hidden;
  }

  .about-hero__title {
    font-size: clamp(2.75rem, 7vw, 4.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 1.5rem;
  }

  .about-hero__emphasis {
    font-style: italic;
    color: var(--accent);
    font-weight: 400;
  }

  .about-hero__lead {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--ink);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .about-hero__text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--ink-muted);
    margin-bottom: 2rem;
  }

  .about-hero__portrait {
    margin-top: 2.5rem;
  }

  @media (min-width: 768px) {
    .about-hero__portrait {
      margin-top: 0;
      display: flex;
      justify-content: flex-end;
      align-items: center;
    }
  }

  .about-hero__frame {
    width: 100%;
    max-width: 25rem;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid rgba(20, 24, 32, 0.06);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.8) inset,
      0 16px 48px rgba(20, 24, 32, 0.1);
  }

  .about-hero__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* —— Content / tabs —— */
  .about-content {
    padding: 4rem 0 6rem;
    background: #fff;
    position: relative;
  }

  .about-content::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cream-deep), transparent);
  }

  .about-content__header {
    margin-bottom: 2rem;
  }

  .about-content__title {
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.1;
    color: var(--ink);
  }

  .about-tabs {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.35rem;
    background: var(--cream);
    border-radius: 999px;
    margin-bottom: 3rem;
    border: 1px solid var(--cream-deep);
  }

  .about-tab {
    padding: 0.65rem 1.35rem;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  .about-tab:hover {
    color: var(--ink);
  }

  .about-tab.is-active {
    background: #fff;
    color: var(--ink);
    box-shadow: 0 2px 12px rgba(20, 24, 32, 0.08);
  }

  .about-panel.hidden {
    display: none;
  }

  /* —— Timeline —— */
  .timeline {
    position: relative;
    padding-bottom: 1rem;
  }

  .timeline__line {
    position: absolute;
    left: 1.25rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, var(--accent-soft), var(--cream-deep));
  }

  @media (min-width: 768px) {
    .timeline__line {
      left: 50%;
      transform: translateX(-50%);
    }
  }

  .timeline-step {
    position: relative;
    display: flex;
    gap: 1rem;
    padding-left: 3.25rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .timeline-step {
      padding-left: 0;
      width: 50%;
      margin-left: 0;
      padding-right: 2.5rem;
    }

    .timeline-step--reverse {
      margin-left: 50%;
      padding-right: 0;
      padding-left: 2.5rem;
    }
  }

  .timeline-step__num {
    position: absolute;
    left: 0;
    top: 0.15rem;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent);
    background: #fff;
    border: 1px solid var(--cream-deep);
    border-radius: 50%;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(20, 24, 32, 0.06);
  }

  @media (min-width: 768px) {
    .timeline-step__num {
      left: auto;
      right: -1.25rem;
    }

    .timeline-step--reverse .timeline-step__num {
      right: auto;
      left: -1.25rem;
    }
  }

  .timeline-card {
    flex: 1;
    background: #fff;
    border: 1px solid rgba(20, 24, 32, 0.06);
    border-radius: 1rem;
    padding: 1.5rem 1.75rem;
    box-shadow: 0 8px 32px rgba(20, 24, 32, 0.06);
    transition: box-shadow 0.25s ease;
  }

  .timeline-card:hover {
    box-shadow: 0 12px 40px rgba(20, 24, 32, 0.09);
  }

  .timeline-card--quote p {
    font-size: 1.15rem;
    line-height: 1.65;
    font-style: italic;
    color: var(--ink);
    margin: 0;
  }

  .timeline-card__title {
    font-family: 'Archivo', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }

  .timeline-card p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--ink-muted);
    margin: 0 0 0.75rem;
  }

  .timeline-card p:last-child {
    margin-bottom: 0;
  }

  .timeline-card__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .timeline-card__list li {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-muted);
    padding-left: 1rem;
    position: relative;
  }

  .timeline-card__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent-soft);
  }

  .timeline-card__intro {
    margin-bottom: 1rem !important;
  }

  .timeline-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .timeline-card__tags span {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: var(--cream);
    color: var(--ink-muted);
  }

  /* —— Craft gallery —— */
  .about-panel--craft {
    padding-top: 1rem;
  }

  .craft-intro {
    text-align: center;
    max-width: 32rem;
    margin: 0 auto 4rem;
  }

  .craft-intro__quote {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    font-style: italic;
    line-height: 1.5;
    color: var(--ink);
    margin-bottom: 1.25rem;
  }

  .craft-intro__text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--ink-muted);
  }

  .craft-gallery {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .craft-gallery {
      gap: 5rem;
    }
  }

  .craft-item img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  .craft-item figcaption {
    margin-top: 1.25rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--ink-muted);
    text-align: center;
  }

  @media (min-width: 768px) {
    .craft-item figcaption {
      text-align: left;
    }
  }

  .craft-item figcaption em {
    display: block;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    color: var(--ink-muted);
    opacity: 0.85;
  }

  .craft-section-title {
    font-size: 1.35rem;
    color: var(--ink);
    padding-top: 2rem;
    margin: 2rem 0 0;
    border-top: 1px solid var(--cream-deep);
  }
</style>
